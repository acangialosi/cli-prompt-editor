<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>PromptEditor</AssemblyName>
    <RootNamespace>PromptEditor</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Version>0.1.0</Version>
    <Description>A lightweight Markdown prompt editor for Copilot CLI.</Description>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="PromptEditor.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.4.1" />
  </ItemGroup>
</Project>
